DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="generate-with-crypto-randomBytes-32-hex"
QR_SECRET="generate-with-crypto-randomBytes-32-hex"

# Supabase Storage — required for absence justification uploads.
# Create a PRIVATE bucket named "justifications" in Supabase dashboard
# (Storage → New bucket → name: justifications, public: false).
# Use the SERVICE ROLE key, not the anon key. Never expose to frontend.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-settings-api"

PORT=3000
NODE_ENV=development

# Admin Portal
JWT_ADMIN_SECRET="change-me-min-32-chars"
JWT_ADMIN_REFRESH_SECRET="change-me-min-32-chars"
ADMIN_CORS_ORIGIN="http://localhost:3001"

# Shared secret authorising the PWA proxy's x-unipocket-client-ip header; leave empty to disable.
PWA_PROXY_SECRET=""
