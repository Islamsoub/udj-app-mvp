generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProgrammeLevel {
  DUT
  LICENCE
  MASTER
  DOCTORAT
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
}

enum ScheduleEntryType {
  CM
  TD
  TP
  EXAM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PARTIAL // NEW — attended part of a session; hours in AttendanceRecord.hoursAttended
  JUSTIFIED
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  GRADES
  SCHEDULE
  ATTENDANCE
  GENERAL
  NEWS // NEW — urgent / opted-in news-article push notifications
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Faculty {
  id         String      @id @default(uuid())
  nameFr     String      @map("name_fr")
  nameAr     String      @map("name_ar")
  code       String      @unique
  email      String
  phone      String
  address    String
  hours      String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  programmes Programme[]
  admins     Admin[]

  @@map("faculties")
}

model Programme {
  id                String         @id @default(uuid())
  facultyId         String         @map("faculty_id")
  nameFr            String         @map("name_fr")
  nameAr            String         @map("name_ar")
  code              String         @unique
  level             ProgrammeLevel
  durationSemesters Int            @map("duration_semesters")
  totalCredits      Int            @map("total_credits")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  faculty           Faculty        @relation(fields: [facultyId], references: [id])
  students          Student[]
  subjects          Subject[]

  @@map("programmes")
}

model Student {
  id                  String             @id @default(uuid())
  programmeId         String             @map("programme_id")
  studentIdDisplay    String             @unique @map("student_id_display")
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  email               String             @unique
  photoUrl            String?            @map("photo_url")
  currentSemester     Int                @map("current_semester")
  status              StudentStatus      @default(ACTIVE)
  passwordHash        String             @map("password_hash")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  notifGrades         Boolean            @default(true) @map("notif_grades")
  notifCourses        Boolean            @default(true) @map("notif_courses")
  notifAttendance     Boolean            @default(true) @map("notif_attendance")
  quietHoursStart     String?            @map("quiet_hours_start")
  quietHoursEnd       String?            @map("quiet_hours_end")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  programme           Programme          @relation(fields: [programmeId], references: [id])
  grades              Grade[]
  attendanceRecords   AttendanceRecord[]
  notifications       Notification[]
  qrTokens            QrToken[]
  refreshTokens       RefreshToken[]
  pushTokens          PushToken[]

  @@index([programmeId])
  @@map("students")
}

model Semester {
  id              String          @id @default(uuid())
  label           String
  academicYear    String          @map("academic_year")
  startDate       DateTime        @map("start_date")
  endDate         DateTime        @map("end_date")
  isCurrent       Boolean         @default(false) @map("is_current")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  subjects        Subject[]
  grades          Grade[]
  scheduleEntries ScheduleEntry[]

  @@map("semesters")
}

model Subject {
  id                String             @id @default(uuid())
  programmeId       String             @map("programme_id")
  semesterId        String             @map("semester_id")
  nameFr            String             @map("name_fr")
  nameAr            String             @map("name_ar")
  code              String
  coefficient       Float
  credits           Int
  hoursCm           Float              @default(0) @map("hours_cm")
  hoursTd           Float              @default(0) @map("hours_td")
  hoursTp           Float              @default(0) @map("hours_tp")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  programme         Programme          @relation(fields: [programmeId], references: [id])
  semester          Semester           @relation(fields: [semesterId], references: [id])
  grades            Grade[]
  scheduleEntries   ScheduleEntry[]
  attendanceRecords AttendanceRecord[]

  @@unique([programmeId, semesterId, code])
  @@map("subjects")
}

model Grade {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  subjectId   String    @map("subject_id")
  semesterId  String    @map("semester_id")
  noteCc      Float?    @map("note_cc")
  noteCf      Float?    @map("note_cf")
  noteFinale  Float?    @map("note_finale")
  isValidated Boolean   @default(false) @map("is_validated")
  publishedCcAt DateTime? @map("published_cc_at") // CC (contrôle continu) publication moment
  publishedNfAt DateTime? @map("published_nf_at") // NF (note finale / résultats finaux) publication moment
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  student     Student   @relation(fields: [studentId], references: [id])
  subject     Subject   @relation(fields: [subjectId], references: [id])
  semester    Semester  @relation(fields: [semesterId], references: [id])

  @@unique([studentId, subjectId, semesterId])
  @@index([subjectId, semesterId])
  @@map("grades")
}

model ScheduleEntry {
  id            String            @id @default(uuid())
  subjectId     String            @map("subject_id")
  semesterId    String            @map("semester_id")
  dayOfWeek     Int               @map("day_of_week")
  startTime     String            @map("start_time")
  endTime       String            @map("end_time")
  room          String
  professorName String            @map("professor_name")
  type          ScheduleEntryType
  effectiveDate DateTime          @map("effective_date")
  expiryDate    DateTime?         @map("expiry_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  subject       Subject           @relation(fields: [subjectId], references: [id])
  semester      Semester          @relation(fields: [semesterId], references: [id])

  @@index([subjectId, semesterId])
  @@map("schedule_entries")
}

model AttendanceRecord {
  id                  String               @id @default(uuid())
  studentId           String               @map("student_id")
  subjectId           String               @map("subject_id")
  sessionDate         DateTime             @map("session_date")
  status              AttendanceStatus
  hoursAttended       Float?               @map("hours_attended") // NEW — only set when status = PARTIAL
  justificationUrl    String?              @map("justification_url")
  justificationStatus JustificationStatus? @map("justification_status")
  justificationNote   String?              @map("justification_note")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  student             Student              @relation(fields: [studentId], references: [id])
  subject             Subject              @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, sessionDate])
  @@index([subjectId])
  @@map("attendance_records")
}

model Notification {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  type      NotificationType
  titleFr   String           @map("title_fr")
  titleAr   String           @map("title_ar")
  bodyFr    String           @map("body_fr")
  bodyAr    String           @map("body_ar")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  student   Student          @relation(fields: [studentId], references: [id])

  @@index([createdAt])
  @@index([studentId, createdAt])
  @@map("notifications")
}

model NewsArticle {
  id              String   @id @default(uuid())
  titleFr         String   @map("title_fr")
  titleAr         String   @map("title_ar")
  bodyFr          String   @map("body_fr")
  bodyAr          String   @map("body_ar")
  heroImageUrl    String?  @map("hero_image_url")
  category        String // KEPT for backward compat (stores the category slug)
  categoryId      String?       @map("category_id") // NEW — FK to NewsCategory
  categoryRel     NewsCategory? @relation(fields: [categoryId], references: [id]) // NEW
  readTimeMinutes Int      @default(3) @map("read_time_minutes")
  isUrgent        Boolean  @default(false) @map("is_urgent")
  publishedAt     DateTime @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@map("news_articles")
}

model NewsCategory {
  id           String   @id @default(uuid())
  nameFr       String   @map("name_fr")
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articles NewsArticle[]

  @@map("news_categories")
}

model QrToken {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  jwtToken  String   @map("jwt_token")
  issuedAt  DateTime @map("issued_at")
  expiresAt DateTime @map("expires_at")
  student   Student  @relation(fields: [studentId], references: [id])

  @@map("qr_tokens")
}

model PushToken {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  token     String   @unique
  platform  String   @default("android") @map("platform")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("push_tokens")
}

model RefreshToken {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  tokenHash  String   @map("token_hash")
  deviceName String?  @map("device_name")
  issuedAt   DateTime @map("issued_at")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([tokenHash])
  @@index([studentId])
  @@map("refresh_tokens")
}

// ─── Admin Portal ────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN   // Full access to everything
  FACULTY_ADMIN // Scoped to their faculty's programmes/students
  REGISTRAR     // Grades + attendance + student records (read/write)
  NEWS_EDITOR   // News articles + notifications only
}

model Admin {
  id            String              @id @default(uuid())
  email         String              @unique
  passwordHash  String              @map("password_hash")
  firstName     String              @map("first_name")
  lastName      String              @map("last_name")
  role          AdminRole
  facultyId     String?             @map("faculty_id")
  isActive      Boolean             @default(true) @map("is_active")
  lastLoginAt   DateTime?           @map("last_login_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  faculty       Faculty?            @relation(fields: [facultyId], references: [id])
  refreshTokens AdminRefreshToken[]
  auditLogs     AuditLog[]

  @@map("admins")
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String // dot-notation, e.g. "student.update", "grade.publish"
  entityType String   @map("entity_type") // e.g. "Student", "Grade", "NewsArticle"
  entityId   String?  @map("entity_id")
  before     Json? // Snapshot before change (null for creates)
  after      Json? // Snapshot after change (null for deletes)
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Single-row settings store (reconciliation doc §5). The row is created by the
// seed with id="singleton"; all settings routes read/write this one row.
model SystemSettings {
  id                  String   @id @default("singleton")
  gradeWeightCc       Float    @default(0.40) @map("grade_weight_cc")
  gradeWeightCf       Float    @default(0.60) @map("grade_weight_cf")
  attendanceThreshold Int      @default(75) @map("attendance_threshold")
  justificationDeadlineDays Int      @default(8) @map("justification_deadline_days") // NEW
  autoPublishGrades   Boolean  @default(false) @map("auto_publish_grades")
  notifyOnPublish     Boolean  @default(true) @map("notify_on_publish")
  weeklyRecap         Boolean  @default(false) @map("weekly_recap")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
