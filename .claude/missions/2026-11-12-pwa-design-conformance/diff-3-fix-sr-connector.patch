diff --git a/pwa/components/dashboard/dashboard.module.css b/pwa/components/dashboard/dashboard.module.css
index a73f80e..a3cfda2 100644
--- a/pwa/components/dashboard/dashboard.module.css
+++ b/pwa/components/dashboard/dashboard.module.css
@@ -536,6 +536,24 @@ html[lang="ar"] .heading {
   display: block;
 }
 
+/*
+ * Screen-reader-only text: the "à" / "إلى" between the start and end times.
+ * The two-line time column has no visible connector (§5), so without it a
+ * screen reader reads "10:00 11:30". Absolutely positioned, so it takes no
+ * part in the column's flex layout. Same rule as shell.module.css .srOnly.
+ */
+.srOnly {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
 /* ── Hero stats ────────────────────────────────────────────────────────────── */
 
