{
  "$meta": {
    "product": "Unipocket PWA",
    "source": "pwa/app/globals.css on develop (Islamsoub/udj-app-mvp), rebuilt 2026-11-09. Same values as tokens/pwa/tokens.css.",
    "supersedes": "the 2026-11-09 close-out tokens.json (ink2 #6C7267 / ink3 #9CA396 were stale) and archive/pwa/login/tokens-login-only/*"
  },
  "root": {
    "font-sans": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "font-ar": "'Noto Naskh Arabic', 'Plus Jakarta Sans', 'Noto Naskh Arabic UI', 'Droid Arabic Naskh', 'Geeza Pro', 'Al Bayan', 'Traditional Arabic', 'Simplified Arabic', 'Segoe UI', serif",
    "font-mono": "'DM Mono', ui-monospace, 'SF Mono', 'Cascadia Mono', 'Roboto Mono', Menlo, Consolas, monospace",
    "sidebar-w": "240px",
    "r-sm": "8px", "r-md": "12px", "r-lg": "16px", "r-xl": "20px", "r-2xl": "24px",
    "dur-instant": "100ms", "dur-fast": "180ms", "dur-base": "250ms", "dur-slow": "450ms",
    "ease-out": "cubic-bezier(.16, 1, .3, 1)", "ease-in-out": "cubic-bezier(.4, 0, .2, 1)"
  },
  "color": {
    "light": {
      "bg": "#F7F4EE", "surface": "#FFFFFF", "surface2": "#F8F5EF", "sunken": "#EFEAE0",
      "ink": "#1E231F", "ink2": "#656B60", "ink3": "#80867A",
      "hair": "rgba(30, 35, 31, .10)", "hair2": "rgba(30, 35, 31, .16)",
      "jade": "#1D9E75", "jade-hover": "#22B083", "jade-text": "#0F6E56", "jade-faint": "rgba(29, 158, 117, .10)", "on-jade": "#1E231F",
      "hero-bg": "linear-gradient(155deg, #168666, #0F6E56)", "hero-ink": "#FFFFFF", "hero-mark": "var(--hero-ink)",
      "hero-chip": "rgba(10, 61, 46, .40)", "hero-chip-hover": "rgba(10, 61, 46, .50)",
      "shadow-card": "0 2px 10px rgba(30, 35, 31, .06)", "shadow-lg": "0 12px 32px rgba(30, 35, 31, .12)",
      "shadow-panel": "0 0 0 1px rgba(30, 35, 31, .04), -12px 0 32px rgba(30, 35, 31, .10)", "scrim": "rgba(30, 35, 31, .40)",
      "danger": "#EF4444", "danger-bg": "rgba(239, 68, 68, .10)", "warning": "#F59E0B", "warning-bg": "rgba(245, 158, 11, .14)",
      "info": "#3B82F6", "info-bg": "rgba(59, 130, 246, .12)", "exam": "#8B5CF6", "exam-bg": "rgba(139, 92, 246, .12)",
      "danger-ink": "#B3261E", "info-ink": "#1D4ED8", "warning-ink": "#8A5200", "exam-ink": "#6D28D9"
    },
    "dark": {
      "bg": "#15201A", "surface": "#1C2721", "surface2": "#22302A", "sunken": "#0F1713",
      "ink": "#EDF2ED", "ink2": "#9FB0A6", "ink3": "#71887C",
      "hair": "rgba(255, 255, 255, .08)", "hair2": "rgba(255, 255, 255, .14)",
      "jade": "#2BB989", "jade-hover": "#3FCB9A", "jade-text": "#5FD3A6", "jade-faint": "rgba(43, 185, 137, .16)", "on-jade": "#0F1713",
      "hero-bg": "linear-gradient(155deg, #0F5E48, #0A3D2E)", "hero-ink": "#FFFFFF", "hero-mark": "var(--hero-ink)",
      "hero-chip": "rgba(10, 61, 46, .40)", "hero-chip-hover": "rgba(10, 61, 46, .50)",
      "shadow-card": "0 0 0 1px rgba(255, 255, 255, .06), 0 2px 8px rgba(0, 0, 0, .40)",
      "shadow-lg": "0 0 0 1px rgba(255, 255, 255, .08), 0 16px 40px rgba(0, 0, 0, .55)",
      "shadow-panel": "0 0 0 1px rgba(255, 255, 255, .08), -16px 0 40px rgba(0, 0, 0, .60)", "scrim": "rgba(0, 0, 0, .60)",
      "danger": "#FF6B6B", "danger-bg": "rgba(255, 107, 107, .15)", "warning": "#F0A84B", "warning-bg": "rgba(240, 168, 75, .16)",
      "info": "#5AA0E6", "info-bg": "rgba(90, 160, 230, .18)", "exam": "#A98BF0", "exam-bg": "rgba(169, 139, 240, .18)",
      "danger-ink": "#FF9B8F", "info-ink": "#8AB4FF", "warning-ink": "#F2B35E", "exam-ink": "#C4B0FF"
    }
  },
  "notTokens": {
    "gpaCardGradient": "linear-gradient(150deg, #168666, #0F6E56), both themes; depth circle rgba(255,255,255,.07). Not a custom property in globals.css.",
    "loginHeroCircles": "rgba(255, 255, 255, .04)"
  },
  "attendanceBand": {
    "source": "server-computed band and absencesLeft (Round 2 §1); clients never derive a band",
    "ok":    { "ring": "--jade",        "label": "--jade-text",   "line": "--ink2" },
    "near":  { "ring": "--warning-ink", "label": "--warning-ink", "line": "--warning-ink" },
    "below": { "ring": "--danger",      "label": "--danger-ink",  "line": "--danger-ink" },
    "note": "Ring strokes on --surface, light/dark: jade 3.39/6.17, warning-ink 6.39/8.36, danger 3.76/5.56. --warning (#F59E0B, 2.15) is not used for the ring."
  },
  "switch": {
    "track": "38x22; off: transparent with inset 0 0 0 2px --ink2; on: --jade",
    "knob": "off: 16px --ink2 at 3px inset; on: 22px --on-jade, flush (top 0, inline-start 16px)",
    "source": "pwa/components/login/login.module.css .switch"
  }
}
