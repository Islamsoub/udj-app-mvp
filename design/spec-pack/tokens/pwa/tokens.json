{
  "$meta": {
    "product": "Unipocket PWA",
    "sources": [
      "specs/pwa/dashboard/css/app.css (2026-10-27)",
      "specs/pwa/dashboard/Round 2 Spec.html §1, §3 (2026-10-27)",
      "pwa/app/globals.css on develop (ink, on-jade, jade-hover, hero-chip names and values)"
    ],
    "supersedes": "archive/pwa/login/tokens-login-only/tokens.json (pre-Round-2, no warning/exam tokens) and tokens.css (light only despite its label)"
  },
  "root": {
    "font-sans": "'Plus Jakarta Sans',sans-serif",
    "font-ar": "'Noto Naskh Arabic',serif",
    "font-mono": "'DM Mono',monospace",
    "sidebar-w": "240px",
    "r-sm": "8px",
    "r-md": "12px",
    "r-lg": "16px",
    "r-xl": "20px",
    "r-2xl": "24px",
    "shadow-card": "0 2px 10px rgba(30,35,31,.06)",
    "shadow-lg": "0 12px 32px rgba(30,35,31,.12)",
    "shadow-panel": "0 0 0 1px rgba(30,35,31,.04),-12px 0 32px rgba(30,35,31,.10)"
  },
  "color": {
    "light": {
      "bg": "#F7F4EE",
      "surface": "#FFFFFF",
      "surface2": "#F8F5EF",
      "sunken": "#EFEAE0",
      "ink": "#1E231F",
      "ink2": "#6C7267",
      "ink3": "#9CA396",
      "hair": "rgba(30,35,31,.10)",
      "hair2": "rgba(30,35,31,.16)",
      "jade": "#1D9E75",
      "jade-hover": "#22B083",
      "jade-text": "#0F6E56",
      "jade-faint": "rgba(29,158,117,.10)",
      "danger": "#EF4444",
      "danger-bg": "rgba(239,68,68,.10)",
      "warning": "#F59E0B",
      "warning-bg": "rgba(245,158,11,.14)",
      "info": "#3B82F6",
      "info-bg": "rgba(59,130,246,.12)",
      "exam": "#8B5CF6",
      "exam-bg": "rgba(139,92,246,.12)",
      "warning-ink": "#8A5200",
      "danger-ink": "#B3261E",
      "on-jade": "#1E231F"
    },
    "dark": {
      "bg": "#15201A",
      "surface": "#1C2721",
      "surface2": "#22302A",
      "sunken": "#0F1713",
      "ink": "#EDF2ED",
      "ink2": "#9FB0A6",
      "ink3": "#71887C",
      "hair": "rgba(255,255,255,.08)",
      "hair2": "rgba(255,255,255,.14)",
      "jade": "#2BB989",
      "jade-hover": "#3FCB9A",
      "jade-text": "#5FD3A6",
      "jade-faint": "rgba(43,185,137,.16)",
      "danger": "#FF6B6B",
      "danger-bg": "rgba(255,107,107,.15)",
      "warning": "#F0A84B",
      "warning-bg": "rgba(240,168,75,.16)",
      "info": "#5AA0E6",
      "info-bg": "rgba(90,160,230,.18)",
      "exam": "#A98BF0",
      "exam-bg": "rgba(169,139,240,.18)",
      "warning-ink": "#F2B35E",
      "danger-ink": "#FF9B8F",
      "on-jade": "#0F1713"
    }
  },
  "gradient": {
    "loginHero": "see loginHero (theme-specific)",
    "gpaCard": "linear-gradient(150deg, #168666, #0F6E56)",
    "note": "GPA card (150deg #168666→#0F6E56) is the same in both themes; the login hero is darker in dark mode."
  },
  "onHero": {
    "text": "#FFFFFF",
    "tagline": "#FFFFFF",
    "gpaLabel": "#FFFFFF",
    "gpaSuffix": "#FFFFFF",
    "langChipBg": "var(--hero-chip)",
    "mentionBadgeBg": "rgba(0,0,0,.16)",
    "blob": "rgba(255,255,255,.04) (login hero); GPA card depth circle stays .07",
    "depthCircle": "rgba(255,255,255,.07)"
  },
  "attendanceBand": {
    "source": "server-computed band (Round 2 §1); clients never hard-code a percentage",
    "ok": {
      "ring": "--jade",
      "text": "--jade-text"
    },
    "near": {
      "ring": "--warning",
      "text": "--warning-ink"
    },
    "below": {
      "ring": "--danger",
      "text": "--danger-ink"
    },
    "allOkSentence": "--ink2"
  },
  "font": {
    "sans": "'Plus Jakarta Sans', sans-serif",
    "arabic": "'Noto Naskh Arabic', serif",
    "mono": "'DM Mono', monospace"
  },
  "loginHero": {
    "light": {
      "hero-bg": "linear-gradient(155deg, #168666, #0F6E56)",
      "hero-ink": "#FFFFFF",
      "hero-mark": "#FFFFFF",
      "hero-chip": "rgba(10,61,46,.40)",
      "hero-chip-hover": "rgba(10,61,46,.50)"
    },
    "dark": {
      "hero-bg": "linear-gradient(155deg, #0F5E48, #0A3D2E)",
      "hero-ink": "#FFFFFF",
      "hero-mark": "#FFFFFF",
      "hero-chip": "rgba(10,61,46,.40)",
      "hero-chip-hover": "rgba(10,61,46,.50)"
    },
    "blob": "rgba(255,255,255,.04)"
  }
}