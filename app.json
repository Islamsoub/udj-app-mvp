{
  "expo": {
    "name": "UDJ",
    "slug": "udj-app-mvp",
    "version": "1.0.0",
    "scheme": [
      "udj",
      "unipocket"
    ],
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A3D2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dj.univ.udj"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-icon-background.png",
        "backgroundColor": "#0A3D2E"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "dj.univ.udj",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3D2E",
          "image": "./assets/icons/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon.png",
          "color": "#1D9E75"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "unipocket",
          "project": "unipocket",
          "uploadSourceMapsToSentry": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4750a290-57f1-4d40-a0bb-f593987be0ff"
      }
    }
  }
}
