// ─────────────────────────────────────────────────────────────────────────────
// Unipocket Admin Portal — Prisma schema additions
//
// Paste these blocks into backend/prisma/schema.prisma. All additions are
// purely additive (no changes to existing columns), per architecture doc §4
// and reconciliation doc §8. After merging, run:
//   npx prisma migrate dev --name admin_portal
//
// Total models after migration: 16 (12 existing + Admin, AdminRefreshToken,
// AuditLog, SystemSettings). Faculty gets one new relation field.
// ─────────────────────────────────────────────────────────────────────────────

// ─── New enum ────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN   // Full access to everything
  FACULTY_ADMIN // Scoped to their faculty's programmes/students
  REGISTRAR     // Grades + attendance + student records (read/write)
  NEWS_EDITOR   // News articles + notifications only
}

// ─── New models ──────────────────────────────────────────────────────────────

model Admin {
  id            String              @id @default(uuid())
  email         String              @unique
  passwordHash  String              @map("password_hash")
  firstName     String              @map("first_name")
  lastName      String              @map("last_name")
  role          AdminRole
  facultyId     String?             @map("faculty_id")
  isActive      Boolean             @default(true) @map("is_active")
  lastLoginAt   DateTime?           @map("last_login_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  faculty       Faculty?            @relation(fields: [facultyId], references: [id])
  refreshTokens AdminRefreshToken[]
  auditLogs     AuditLog[]

  @@map("admins")
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String // dot-notation, e.g. "student.update", "grade.publish"
  entityType String   @map("entity_type") // e.g. "Student", "Grade", "NewsArticle"
  entityId   String?  @map("entity_id")
  before     Json? // Snapshot before change (null for creates)
  after      Json? // Snapshot after change (null for deletes)
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Single-row settings store (reconciliation doc §5). The row is created by the
// seed with id="singleton"; all settings routes read/write this one row.
model SystemSettings {
  id                  String   @id @default("singleton")
  gradeWeightCc       Float    @default(0.40) @map("grade_weight_cc")
  gradeWeightCf       Float    @default(0.60) @map("grade_weight_cf")
  attendanceThreshold Int      @default(75) @map("attendance_threshold")
  autoPublishGrades   Boolean  @default(false) @map("auto_publish_grades")
  notifyOnPublish     Boolean  @default(true) @map("notify_on_publish")
  weeklyRecap         Boolean  @default(false) @map("weekly_recap")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

